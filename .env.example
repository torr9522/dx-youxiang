NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://mail.example.test
MAIL_DOMAIN=example.test
MAIL_HOST=mail.example.test
DATABASE_PATH=/var/lib/dx-youxiang/app.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$REPLACE_WITH_GENERATED_HASH
SESSION_SECRET=replace-with-at-least-32-random-bytes
STALWART_BASE_URL=http://127.0.0.1:8080
STALWART_USERNAME=service-account@example.test
STALWART_PASSWORD=replace-with-service-account-secret
TLS_CERT_PATH=/etc/dx-youxiang/tls/fullchain.pem
MAIL_STORAGE_PATH=/var/lib/stalwart
TRUST_PROXY=loopback
