[Unit]
Description=Dx 邮箱 web application
After=network-online.target stalwart.service
Wants=network-online.target
Requires=stalwart.service

[Service]
Type=simple
User=dx-youxiang
Group=dx-youxiang
SupplementaryGroups=caddy
WorkingDirectory=/opt/dx-youxiang/current
EnvironmentFile=/etc/dx-youxiang/app.env
ExecStart=/opt/dx-youxiang/runtime/node/bin/node dist/server/index.js
Restart=on-failure
RestartSec=5s
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/dx-youxiang
ReadOnlyPaths=/etc/dx-youxiang /var/lib/stalwart
UMask=0027

[Install]
WantedBy=multi-user.target
